{
  "name": "@dsh-pm/registry",
  "version": "0.1.0",
  "description": "dsh pm registry — discover dsh plugins by merging the awesome-dsh-plugin list, GitHub dsh-plugin-topic search, and npm keyword search into one deduped, offline-tolerant registry",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "registry",
    "discovery",
    "awesome-list",
    "plugin-manager"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jesse-njx/dsh-plugin-manager-registry.git"
  },
  "homepage": "https://github.com/Jesse-njx/dsh-plugin-manager-registry#readme",
  "bugs": {
    "url": "https://github.com/Jesse-njx/dsh-plugin-manager-registry/issues"
  },
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@dsh-pm/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  }
}
